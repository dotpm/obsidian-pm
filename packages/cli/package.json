{
  "name": "@dotpm/cli",
  "version": "0.1.0",
  "description": "Command line for dotpm, the Obsidian project manager: list, search and edit tasks from a terminal or an agent",
  "keywords": [
    "cli",
    "mcp",
    "obsidian",
    "project-management",
    "tasks"
  ],
  "homepage": "https://github.com/dotpm/obsidian-pm/blob/main/docs/cli.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotpm/obsidian-pm.git",
    "directory": "packages/cli"
  },
  "bin": {
    "dotpm": "./dist/dotpm.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@dotpm/api": "workspace:*",
    "@dotpm/core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
