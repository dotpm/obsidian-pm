{
  "name": "project-manager",
  "version": "2.3.1",
  "description": "dotpm — project management for Obsidian",
  "repository": "github:dotpm/obsidian-pm",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:js dev:css",
    "dev:js": "tsdown --watch",
    "dev:css": "node scripts/build-styles.mjs --watch",
    "build": "run-p build:js build:css",
    "build:js": "PRODUCTION=1 tsdown",
    "build:css": "PRODUCTION=1 node scripts/build-styles.mjs",
    "check": "run-p check:**",
    "check:code": "oxlint ./src",
    "check:format": "oxfmt --check ./src",
    "check:submission": "eslint --max-warnings 0 src/",
    "check:types": "tsc -noEmit -skipLibCheck",
    "fix": "run-p fix:**",
    "fix:code": "oxlint --fix ./src",
    "fix:format": "oxfmt ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@2bad/axiom": "2.1.0",
    "@2bad/tsconfig": "4.0.0",
    "@types/node": "26.4.1",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "lightningcss": "1.33.0",
    "npm-run-all2": "9.0.3",
    "obsidian": "1.13.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "temporal-polyfill": "1.0.4",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "11.5.3"
  }
}
